<Window x:Class="ModernScreenShot.App.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ModernScreenShot.App.Controls"
        Title="Editor" Width="1280" Height="840" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <DockPanel LastChildFill="True">
        <!-- Custom title bar row, above the dark toolbar strip (an independent row so the
             action bar's wrap logic below is untouched). -->
        <controls:AppTitleBar DockPanel.Dock="Top" Text="{DynamicResource Editor.Title}"
                              ShowMin="True" ShowMax="True" ShowClose="True"/>
        <Border DockPanel.Dock="Top" x:Name="ToolbarHost" Padding="6,4" BorderBrush="#22000000" BorderThickness="0,0,0,1" />
        <Border DockPanel.Dock="Right" x:Name="PropertiesHost" Width="278" Padding="12,8" BorderBrush="#22000000" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PropertiesPanel" />
            </ScrollViewer>
        </Border>
        <Border DockPanel.Dock="Bottom" x:Name="ActionsHost" Padding="10,6" BorderBrush="#22000000" BorderThickness="0,1,0,0" />
        <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <!-- Dark workbench on the Grid itself: the ScrollViewer template ignores Background,
                 which left a white workbench around the image in the light theme. -->
            <Grid x:Name="CanvasHost" Background="#FF202022" />
        </ScrollViewer>
    </DockPanel>
</Window>
