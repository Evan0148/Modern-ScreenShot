<Window x:Class="ModernScreenShot.App.Translation.TranslationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:ModernScreenShot.App.Controls"
        Title="{DynamicResource Translate.Title}"
        Width="600" Height="520" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <DockPanel LastChildFill="True">
        <controls:AppTitleBar DockPanel.Dock="Top" Text="{DynamicResource Translate.Title}"
                              ShowMin="True" ShowMax="True" ShowClose="True"/>
        <Border DockPanel.Dock="Bottom" Padding="12,8"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ui:Button x:Name="SwapButton" Content="{DynamicResource Translate.Swap}"
                               MinWidth="96" Click="OnSwapClick"
                               ToolTip="{DynamicResource Translate.Swap.Tip}"/>
                    <ui:Button x:Name="CopyButton" Content="{DynamicResource Translate.CopyResult}" Appearance="Primary"
                               Margin="8,0,0,0" MinWidth="96" Click="OnCopyClick"/>
                    <ui:Button Content="{DynamicResource Action.Close}" Margin="8,0,0,0"
                               MinWidth="96" Click="OnCloseClick"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="4,0,12,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <!-- Both boxes are read-only, exactly like the OCR result window: the text that lands on the
             clipboard is what the engine produced, with no unsaved-edit semantics to honour. -->
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.5*" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- Section captions are styled inline: the shared "RowSubtitle" style lives in
                 SettingsWindow's own resources and is not reachable from a standalone window. -->
            <TextBlock x:Name="SourceCaption" Grid.Row="0" Margin="14,10,14,4" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{DynamicResource Translate.Source}"/>
            <TextBox x:Name="SourceHost" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Background="Transparent" Padding="14,0,14,10" FontSize="13"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsReadOnlyCaretVisible="False"/>

            <TextBlock x:Name="ResultCaption" Grid.Row="2" Margin="14,6,14,4" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{DynamicResource Translate.Result}"/>
            <TextBox x:Name="ResultHost" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Background="Transparent" Padding="14,0,14,14" FontSize="15"
                     IsReadOnlyCaretVisible="False"/>
        </Grid>
    </DockPanel>
</Window>
