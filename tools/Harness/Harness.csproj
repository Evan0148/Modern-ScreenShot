<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ModernScreenShot.Core\ModernScreenShot.Core.csproj" />
    <!-- Direct reference so the RapidOcrNet .targets (which copies models/v5 next to the binary)
         runs for the harness output as well; build targets are not transitive. -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
  </ItemGroup>

</Project>
